  <div style="position:relative;max-width:880px;padding:96px 24px 130px;">
    <span style="display:inline-block;margin-bottom:18px;padding:7px 18px;border-radius:999px;font-family:'Nunito Sans',sans-serif;font-size:12px;font-weight:800;letter-spacing:0.16em;text-transform:uppercase;background:rgba(255,255,255,0.14);color:#fff;border:1px solid rgba(255,255,255,0.35);backdrop-filter:blur(3px);">Licensed Removalists · Geelong and the Barwon region</span>
